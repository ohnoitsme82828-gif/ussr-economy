# ============================================================================
# USSR ECONOMIC SYSTEM - ENVIRONMENT CONFIGURATION
# ============================================================================
# IMPORTANT: Never commit .env to version control! This file is a template.
# Copy this file to .env and fill in your actual values.

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL via Supabase)
# ============================================================================
# Create a free PostgreSQL database at https://supabase.com
# Get the connection string from: Settings → Database → Connection Strings → Pooler
# Example: postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

DATABASE_URL=postgresql://[user]:[password]@[host]:[port]/[database]

# ============================================================================
# SECURITY - JWT CONFIGURATION (REQUIRED)
# ============================================================================
# Generate a strong random secret (at least 32 characters)
# NEVER use the default or share this value!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET=your-random-secret-key-here-at-least-32-chars
JWT_EXPIRY_HOURS=168

# ============================================================================
# ADMIN ACCOUNT INITIALIZATION (REQUIRED)
# ============================================================================
# Initial admin credentials (set these before first deployment)
# After deployment, change password via admin panel

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=your-secure-admin-password-here

# ============================================================================
# ECONOMIC SYSTEM CONFIGURATION
# ============================================================================
# These are defaults; can be changed later via admin panel

BASE_CONVERSION_RATE=0.8
MINIMUM_CONVERSION_AMOUNT=100
DEFAULT_TAX_RATE=0.05
DAILY_TRANSFER_LIMIT=10000
WEEKLY_TRANSFER_LIMIT=50000
TRANSFER_COOLDOWN_SECONDS=60
MINIMUM_ACCOUNT_AGE_DAYS=1

# ============================================================================
# DEPLOYMENT & FRONTEND CONFIGURATION
# ============================================================================
# For Vercel: Leave NEXT_PUBLIC_BASE_URL empty or use your Vercel domain
# Vercel will automatically set this

NODE_ENV=production
NEXT_PUBLIC_BASE_URL=https://your-vercel-domain.vercel.app

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# For Discord bot integration or mobile apps, specify allowed origins
# Leave as * for open access (recommended for Discord sharing)

CORS_ORIGINS=*

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
# Vercel Free Tier:
# - Unlimited deployments
# - 100 GB bandwidth/month
# - 1M serverless function invocations/month
# - Sufficient for 50-500 concurrent users
#
# Supabase Free Tier:
# - 500 MB storage
# - 100 concurrent connections
# - 2 projects max
# - Full PostgreSQL features
#
# IMPORTANT: Keep JWT_SECRET and INITIAL_ADMIN_PASSWORD secure!
